<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/historyScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/historyContent"
        style="@style/PageContent">

        <LinearLayout
            android:id="@+id/trends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/monthsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:paddingStart="4dp"
            android:text="All months"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/historyEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <FrameLayout
                android:layout_width="124dp"
                android:layout_height="84dp">

                <ImageView
                    style="@style/IconBadge"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="start|center_vertical"
                    android:padding="20dp"
                    android:backgroundTint="@color/water_container"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_water"
                    app:tint="@color/water_accent" />

                <ImageView
                    style="@style/IconBadge"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="end|center_vertical"
                    android:padding="20dp"
                    android:backgroundTint="@color/elec_container"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/elec_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="No months saved yet"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Work out a month on the Calculate tab, then tap Save to history. Your trends will show up here."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
