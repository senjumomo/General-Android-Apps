<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.senjumomo.utilities.HeaderAppBar
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.App.Hero">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/main"
            app:title="Utilities"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge"
            app:titleTextColor="@color/hero_text">

            <!-- Appears when the big header has scrolled away, so the total is never out of sight. -->
            <TextView
                android:id="@+id/toolbarTotal"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:alpha="0"
                android:background="@drawable/hero_chip"
                android:fontFamily="@font/manrope_800"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/hero_text"
                android:textSize="14sp" />
        </com.google.android.material.appbar.MaterialToolbar>

        <FrameLayout
            android:id="@+id/heroArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll">

            <include
                android:id="@+id/heroCalc"
                layout="@layout/view_hero_calc" />

            <include
                android:id="@+id/heroHistory"
                layout="@layout/view_hero_history"
                android:visibility="gone" />
        </FrameLayout>
    </com.senjumomo.utilities.HeaderAppBar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/calculatePage"
                layout="@layout/view_calculate" />

            <include
                android:id="@+id/historyPage"
                layout="@layout/view_history"
                android:visibility="gone" />
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
