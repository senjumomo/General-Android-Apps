<?xml version="1.0" encoding="utf-8"?>
<!-- Thin strip the History header shrinks to. -->
<com.senjumomo.utilities.FadeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_gravity="bottom"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:tag="compact">

    <TextView
        android:id="@+id/compactAvg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_800"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="@color/hero_text"
        android:textSize="26sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/manrope_600"
        android:text="average per month"
        android:textColor="@color/hero_text_dim"
        android:textSize="13sp" />
</com.senjumomo.utilities.FadeLinearLayout>
