<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/content"
        style="@style/PageContent">

        <!-- Previous debt -->
        <LinearLayout
            android:id="@+id/debtCard"
            style="@style/Section"
            android:background="@drawable/card_debt"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                style="@style/IconBadge"
                android:backgroundTint="@color/debt_container"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wallet"
                app:tint="@color/debt_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="Previous debt" />
                <TextView style="@style/SectionSubtitle" android:text="Still owed from last month" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/debtTile"
                android:layout_width="124dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/tile_debt"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/TileUnit"
                    android:layout_marginEnd="4dp"
                    android:text="R"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/debt"
                    style="@style/TileInput"
                    android:contentDescription="Previous debt in rand"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Water -->
        <LinearLayout
            android:id="@+id/waterCard"
            style="@style/Section"
            android:background="@drawable/card_water">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/IconBadge"
                    android:backgroundTint="@color/water_container"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_water"
                    app:tint="@color/water_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SectionTitle" android:text="Water" />
                    <TextView style="@style/SectionSubtitle" android:text="Meter readings" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/waterRateEdit"
                    style="@style/RateChip"
                    android:background="@drawable/chip_water"
                    android:contentDescription="Change the water price">

                    <TextView
                        android:id="@+id/waterRate"
                        style="@style/RateChipText"
                        android:textColor="@color/water_on_container" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/water_on_container" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/waterPrevTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/tile_water"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView style="@style/TileLabel" android:text="Last month" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/waterPrev"
                            style="@style/TileInput"
                            android:contentDescription="Last month's water reading in kilolitres" />

                        <TextView
                            style="@style/TileUnit"
                            android:text="kl" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="?attr/colorOutline" />

                <LinearLayout
                    android:id="@+id/waterCurrTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/tile_water"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView style="@style/TileLabel" android:text="This month" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/waterCurr"
                            style="@style/TileInput"
                            android:contentDescription="This month's water reading in kilolitres" />

                        <TextView
                            style="@style/TileUnit"
                            android:text="kl" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/waterError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/manrope_600"
                android:text="This month's reading is lower than last month's"
                android:textColor="?attr/colorError"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/strip_water"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/waterUsed"
                    style="@style/SubtotalLabel"
                    android:textColor="@color/water_on_container" />

                <TextView
                    android:id="@+id/waterTotal"
                    style="@style/SubtotalValue"
                    android:textColor="@color/water_accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Electricity -->
        <LinearLayout
            android:id="@+id/elecCard"
            style="@style/Section"
            android:background="@drawable/card_elec">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/IconBadge"
                    android:backgroundTint="@color/elec_container"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/elec_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SectionTitle" android:text="Electricity" />
                    <TextView style="@style/SectionSubtitle" android:text="Prepaid tokens" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tokenRateEdit"
                    style="@style/RateChip"
                    android:background="@drawable/chip_elec"
                    android:contentDescription="Change the token price">

                    <TextView
                        android:id="@+id/tokenRate"
                        style="@style/RateChipText"
                        android:textColor="@color/elec_on_container" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/elec_on_container" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/tokensMinus"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/step_bg"
                    android:contentDescription="One token less"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/elec_on_container" />

                <LinearLayout
                    android:id="@+id/tokensTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/tile_elec"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <TextView style="@style/TileLabel" android:text="Tokens bought" />

                    <EditText
                        android:id="@+id/tokens"
                        style="@style/TileInput"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:contentDescription="Number of tokens bought"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:textSize="40sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/tokensPlus"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/step_bg"
                    android:contentDescription="One token more"
                    android:src="@drawable/ic_add"
                    app:tint="@color/elec_on_container" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/strip_elec"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/elecUsed"
                    style="@style/SubtotalLabel"
                    android:textColor="@color/elec_on_container" />

                <TextView
                    android:id="@+id/elecTotal"
                    style="@style/SubtotalValue"
                    android:textColor="@color/elec_accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Message for the landlord -->
        <LinearLayout
            android:id="@+id/messageCard"
            style="@style/Section"
            android:background="@drawable/card_neutral"
            android:visibility="gone">

            <TextView
                style="@style/SectionTitle"
                android:layout_marginBottom="14dp"
                android:text="Message for landlord" />

            <TextView
                android:id="@+id/message"
                style="@style/MessageText"
                android:layout_width="wrap_content"
                android:layout_gravity="end" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/manrope_600"
                android:gravity="end"
                android:paddingEnd="4dp"
                android:text="Sends exactly like this"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copy"
                    style="@style/PillButton.Tonal"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Copy"
                    app:icon="@drawable/ic_copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/share"
                    style="@style/PillButton.Filled"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Share"
                    app:icon="@drawable/ic_share" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveHistory"
                style="@style/PillButton.Outlined"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="Save to history"
                app:icon="@drawable/ic_save" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
