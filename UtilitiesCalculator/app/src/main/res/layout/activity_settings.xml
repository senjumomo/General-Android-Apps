<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.senjumomo.utilities.HeaderBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.App.Hero">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="Back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Settings"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge"
            app:titleTextColor="@color/hero_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_500"
            android:paddingStart="22dp"
            android:paddingTop="4dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp"
            android:text="Set your prices once. The Calculate page uses them for every month."
            android:textColor="@color/hero_text_dim"
            android:textSize="15sp" />
    </com.senjumomo.utilities.HeaderBar>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/settingsContent"
            style="@style/PageContent">

            <LinearLayout
                style="@style/Section"
                android:background="@drawable/card_water">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/water_container"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_water"
                        app:tint="@color/water_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/SectionTitle" android:text="Water price" />
                        <TextView style="@style/SectionSubtitle" android:text="Charged per kilolitre" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/waterPriceTile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/tile_water"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        style="@style/TileUnit"
                        android:layout_marginEnd="6dp"
                        android:text="R"
                        android:textSize="22sp" />

                    <EditText
                        android:id="@+id/waterPrice"
                        style="@style/TileInput"
                        android:contentDescription="Water price per kilolitre in rand"
                        android:textSize="32sp" />

                    <TextView
                        style="@style/TileUnit"
                        android:text="per kl" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Section"
                android:background="@drawable/card_elec">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/elec_container"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bolt"
                        app:tint="@color/elec_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/SectionTitle" android:text="Electricity price" />
                        <TextView style="@style/SectionSubtitle" android:text="Cost of one prepaid token" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tokenPriceTile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/tile_elec"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        style="@style/TileUnit"
                        android:layout_marginEnd="6dp"
                        android:text="R"
                        android:textSize="22sp" />

                    <EditText
                        android:id="@+id/tokenPrice"
                        style="@style/TileInput"
                        android:contentDescription="Price of one token in rand"
                        android:imeOptions="actionDone"
                        android:textSize="32sp" />

                    <TextView
                        style="@style/TileUnit"
                        android:text="per token" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_500"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Changes are saved automatically. Months already in History keep the prices they were saved with."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
