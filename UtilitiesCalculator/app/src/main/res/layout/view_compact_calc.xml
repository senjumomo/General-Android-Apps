<?xml version="1.0" encoding="utf-8"?>
<!-- Thin strip the Calculate header shrinks to: the live total and where it goes. -->
<com.senjumomo.utilities.FadeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_gravity="bottom"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:tag="compact">

    <TextView
        android:id="@+id/compactTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_800"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="@color/hero_text"
        android:textSize="26sp" />

    <com.senjumomo.utilities.SplitBarView
        android:id="@+id/compactSplit"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="1dp"
        android:layout_weight="1" />
</com.senjumomo.utilities.FadeLinearLayout>
