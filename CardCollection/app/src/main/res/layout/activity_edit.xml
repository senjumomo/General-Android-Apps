<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/scroll">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="Back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:titleTextAppearance="?attr/textAppearanceHeadlineSmall" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <com.senjumomo.cards.ui.CardImageView
                android:id="@+id/image"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Card image. Tap to enlarge"
                android:foreground="?attr/selectableItemBackground"
                app:shapeAppearanceOverlay="@style/CardImageLarge" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cards"
                        app:tint="?attr/colorOnPrimaryContainer" />

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_marginStart="12dp"
                        android:text="Card" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/Field"
                    android:hint="Card name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/name"
                        style="@style/FieldInput"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/setNameLayout"
                    style="@style/Dropdown"
                    android:hint="Set">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/setName"
                        style="@style/FieldInput"
                        android:completionThreshold="1"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/codeLayout"
                    style="@style/Field"
                    android:hint="Card code (e.g. MAMA-EN081)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/code"
                        style="@style/FieldInput"
                        android:inputType="textCapCharacters" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/rarityLayout"
                    style="@style/Dropdown"
                    android:layout_marginBottom="0dp"
                    android:hint="Rarity">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/rarity"
                        style="@style/FieldInput"
                        android:completionThreshold="1"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="?attr/colorSecondaryContainer"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_copies"
                        app:tint="?attr/colorOnSecondaryContainer" />

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_marginStart="12dp"
                        android:text="Copies" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quantity"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/minus"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="One fewer"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_remove"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <TextView
                        android:id="@+id/quantity"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/plus"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="One more"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/conditionLayout"
                    style="@style/Dropdown"
                    android:layout_marginBottom="0dp"
                    android:hint="Condition">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/condition"
                        style="@style/FieldInput"
                        android:completionThreshold="1"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/wishlist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="On my wishlist (don't own it yet)"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="?attr/colorTertiaryContainer"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_price"
                        app:tint="?attr/colorOnTertiaryContainer" />

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_marginStart="12dp"
                        android:text="Price" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/valueLayout"
                    style="@style/Field"
                    android:hint="Market value per card"
                    app:prefixText="R">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/value"
                        style="@style/FieldInput"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/paidLayout"
                    style="@style/Field"
                    android:hint="Paid per card (optional)"
                    app:prefixText="R">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/paid"
                        style="@style/FieldInput"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/totals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/infoCard"
            style="@style/SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="?attr/colorSurfaceContainerHighest"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_marginStart="12dp"
                        android:text="Details" />
                </LinearLayout>

                <TextView
                    android:id="@+id/added"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tcgplayer"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="View on TCGplayer"
                    app:icon="@drawable/ic_open" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:text="Save"
                app:icon="@drawable/ic_check" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
